# Backend image for the Ketsa FastAPI service.
# Runs as a non-root user to follow least privilege.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/app

# Install runtime dependencies first for better layer caching.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code.
COPY backend/app ./app

# Run as an unprivileged user (no shell/default shell for defense in depth).
RUN useradd --create-home --shell /usr/sbin/nologin ketsa
USER ketsa

EXPOSE 8000

# Readiness (not just liveness): /api/ready answers 503 while the storage
# backend is unreachable, so an orchestrator replaces a container that is up
# but cannot serve data. The image has no curl, so use the stdlib.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/ready', timeout=4).status == 200 else 1)"

# Single worker is required while the matching engine keeps order books in
# process memory (see app/replica.py). Do not add --workers here.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
