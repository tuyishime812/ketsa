# Frontend environment variables (Next.js)
# For local dev, copy to .env.local and adjust as needed.
# For Vercel, set these in Project Settings -> Environment Variables.
# NOTE: NEXT_PUBLIC_* values are inlined at BUILD time (redeploy after changes).

# --- Split deploy: Backend on Render, Frontend on Vercel ---
# Public HTTPS URL of the Render backend (no trailing slash).
# Runtime: used by server components and the /api/* proxy (app/api/[...path]/route.ts).
KETSA_BACKEND_URL=https://your-ketsa-api.onrender.com

# Build-time (REQUIRED for split deploy): browser WebSocket/live feed connects
# directly to the backend (Next proxy does not handle WS upgrades).
NEXT_PUBLIC_KETSA_BACKEND_URL=https://your-ketsa-api.onrender.com

# Runtime: must match backend KETSA_PROXY_SECRET so the proxy can HMAC-sign
# the real client IP for per-visitor rate limits/admin lockout.
KETSA_PROXY_SECRET=replace-with-shared-secret

# Build-time: public frontend origin for robots/sitemap/Open Graph metadata.
KETSA_SITE_URL=https://your-app.vercel.app

# Build-time (optional): contact email shown on Terms/Privacy pages.
# NEXT_PUBLIC_KETSA_CONTACT_EMAIL=support@example.com

# Runtime (optional): override Content-Security-Policy. Use {nonce} placeholder.
# KETSA_CSP=
