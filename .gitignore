# --- Python / backend ---
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/*.egg-info/
*.py[cod]

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
*.tsbuildinfo

# --- Env / secrets ---
.env
.env.*
!.env.example
!.env.production.example

# --- Local backups / scratch ---
# Stray snapshot folders (e.g. the Firestore-era backup) are kept OUTSIDE the
# repo, but ignore them here too so they can never be committed by accident.
_*-backup-*/
*-backup-*/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*
