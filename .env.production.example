# Ketsa — PRODUCTION environment reference
# Copy the relevant values into your hosting platform's env-var UI.
# See DEPLOY.md for the full walkthrough.

# -----------------------------------------------------------------------------
# Frontend (Vercel / Next.js)  —  root directory: frontend
# -----------------------------------------------------------------------------

# Public HTTPS base URL of the frontend itself. Used at BUILD time by
# robots.txt / sitemap.xml / Open Graph metadata. E.g. https://ketsa.vercel.app
# or your custom domain https://ketsa.example.com
KETSA_SITE_URL=https://your-app.vercel.app

# Public HTTPS base URL of the hosted Ketsa API. Used at RUNTIME by the
# Next.js server component when it fetches live data from the API.
# REQUIRED: if this is unreachable every page renders the "Temporarily
# unavailable" error state — there is no bundled demo dataset to fall back to.
# E.g. https://ketsa-api.onrender.com
KETSA_BACKEND_URL=https://ketsa-api.onrender.com

# Optional: override the Content-Security-Policy emitted by the Next server.
# KETSA_CSP=default-src 'self'; script-src 'self' 'unsafe-inline'; ...

# -----------------------------------------------------------------------------
# Backend (Railway / Render / Fly)  —  start: uvicorn app.main:app
# -----------------------------------------------------------------------------

# Comma-separated CORS allowlist. Set to the REAL hosted frontend origin(s).
# Keep any other origins you need (e.g. Vercel preview domains).
KETSA_ALLOWED_ORIGINS=https://your-app.vercel.app

# Keep docs off for the public read-only API.
KETSA_EXPOSE_DOCS=0

# Requests/IP/60s. 0 disables in-memory limiting (trusted proxy handles it).
KETSA_RATE_LIMIT_PER_MIN=120

# Stricter per-IP budget for write endpoints (wallet mints, trades, deposits,
# withdrawals). Default 30/min on top of the global limiter.
# KETSA_WRITE_RATE_LIMIT_PER_MIN=30

# Money-movement caps (MWK). Wallets mint at ZERO — there is no free-money
# seed — so these bound how much real money can move per transaction / per
# rolling 24h window per wallet.
# KETSA_MAX_DEPOSIT_MWK=1000000
# KETSA_MAX_WITHDRAWAL_MWK=1000000
# KETSA_DAILY_WITHDRAWAL_LIMIT_MWK=3000000

# Admin login brute-force throttle, per client IP. This is the single key to
# the whole site, so keep the defaults unless several admins share one IP.
# KETSA_ADMIN_MAX_FAILURES=10
# KETSA_ADMIN_LOCKOUT_SECONDS=900

# Hard cap on concurrent WebSocket clients (memory-exhaustion guard).
# KETSA_WS_MAX_CONNECTIONS=2000

# ---- Admin panel (REQUIRED in production) -----------------------------------
# Password for the /admin dashboard. This lets you edit all site content
# (markets, hero, ticker, watch, dashboard, footer, etc.) from the browser
# without touching code. Set a strong, unique value — it is the only key to the
# whole site. Never reveal it.
KETSA_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# ---- Storage backend --------------------------------------------------------
# "memory" (default) seeds data in-process — every admin edit resets on
# restart/redeploy. For production persistence use "supabase" (below) so all
# admin-edited content lives in a Supabase Postgres database.
# KETSA_DB_BACKEND=supabase

# Supabase project URL + SECRET service-role key (only when
# KETSA_DB_BACKEND=supabase). The service role bypasses Row Level Security —
# inject it via your host's secret manager, never commit it. Run
# backend/db/schema.sql once in the Supabase SQL editor before first
# start.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- wandePay mobile-money gateway (REQUIRED for payments) -------------------
# Token for the wandePay API that powers wallet deposits/withdrawals in MWK.
# ALSO REQUIRED: KETSA_DB_BACKEND=supabase — wallet balances and the payment
# ledger must survive restarts when real money is involved.
# Treat the token as a secret (inject via your host's secret manager); never
# commit it. Rotate it if it ever leaks. Without a token the /payments
# endpoints respond 503 and trading continues in play-money mode.
# KETSA_WANDE_TOKEN=your-wandepay-token
# KETSA_WANDE_BASE_URL=https://apiv1.wandepay.site/api/

# ---- Auth0 social login ("Continue with Google") — OPTIONAL ------------------
# The whole Authorization Code flow runs SERVER-SIDE in the backend (no Auth0 JS
# SDK ships in the browser bundle), so all three values below are backend env.
# OAuth application type: Regular Web Application.
#
#   KETSA_AUTH0_DOMAIN        - tenant host, e.g. your-tenant.eu.auth0.com
#   KETSA_AUTH0_CLIENT_ID     - app client id (public, but kept backend-side so
#                               the whole flow stays server-driven)
#   KETSA_AUTH0_CLIENT_SECRET - app client SECRET. Inject via your host's secret
#                               manager; never commit. Rotate if it ever leaks.
#
# The Auth0 callback URI is DERIVED, not configured:
#   ${KETSA_PUBLIC_BASE_URL}/api/auth/social/callback
# Register it verbatim in the Auth0 dashboard (Applications -> <app> -> Settings),
# and KETSA_PUBLIC_BASE_URL MUST be the browser-reachable PUBLIC origin of this
# backend (not an internal Docker/compose hostname).
#   Allowed Callback URLs: https://ketsa-api.example.com/api/auth/social/callback
#   Allowed Logout URLs:   https://your-app.vercel.app
#   Allowed Web Origins:   https://your-app.vercel.app
# Then enable the Google social connection. If any KETSA_AUTH0_* value is empty
# the Google button returns 503; email/password login is unaffected.
# KETSA_AUTH0_DOMAIN=
# KETSA_AUTH0_CLIENT_ID=
# KETSA_AUTH0_CLIENT_SECRET=

# Where the browser lands after a successful Google login (the /auth/callback
# page that redeems the single-use, 60-second SSO ticket).
# KETSA_FRONTEND_URL=https://your-app.vercel.app

# Which Auth0 connection may complete a login. Read by BOTH the /authorize
# request and the callback's token-subject check, so the two can never disagree.
# Keep this pinned to one connection: a valid Auth0 signature only proves SOME
# connection in that tenant signed the token (issuer, audience and signing keys
# are shared across all of them), so accepting another would let an account
# holder assert any email and have it silently linked to an existing Ketsa
# account — wallet and balance included.
# KETSA_AUTH0_CONNECTION=google-oauth2
