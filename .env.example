# =============================================================================
# Ketsa — environment configuration reference
# Copy to `.env` / wire into your deployment and adjust as needed.
# Nothing here is secret; keep real secrets out of version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------

# Comma-separated CORS origin allowlist that may call the API from a browser.
# For local dev keep the defaults; in production set to your hosted frontend
# origin (e.g. https://ketsa.example.com). Never use "*" with credentials.
KETSA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to "1" to expose interactive API docs at /docs, /redoc and the OpenAPI
# schema at /openapi.json. Default is OFF for the public read-only API.
KETSA_EXPOSE_DOCS=0

# Requests allowed per client IP per 60s fixed window. 0 disables the limiter
# (e.g. when a trusted reverse proxy / load balancer handles throttling).
KETSA_RATE_LIMIT_PER_MIN=120

# Admin panel access. This is THE password for the /admin dashboard.
# Change it! If left unset it defaults to "ketsa-admin" for local dev only.
# In production you MUST set a strong unique value.
KETSA_ADMIN_PASSWORD=change-me-to-a-strong-password

# Storage backend. "memory" (default) keeps data in-process, seeded from the
# static content — great for local dev/previews with zero setup, but data is
# lost on restart. "supabase" persists everything in a Supabase Postgres
# database (production): all admin edits survive restarts/redeploys.
# KETSA_DB_BACKEND=supabase
KETSA_DB_BACKEND=memory

# wandePay mobile-money gateway for wallet top-ups and payouts (MWK — Airtel
# Money / TNM Mpamba). Payments require the token; without it the /payments
# endpoints respond 503. Treat the token as a secret: set it in the
# environment, never in version control, and rotate it if it ever leaks.
# Dev token provided by wandePay:
# KETSA_WANDE_TOKEN=f9236e22fc79cc01d90e12873549d513240365c24d14d0b170a391
# Base URL (defaults to the production API if unset):
KETSA_WANDE_BASE_URL=https://apiv1.wandepay.site/api/

# Account login throttling: failed logins per email before a temporary
# lockout, and how long the lockout lasts. Defaults: 5 failures / 15 minutes.
# KETSA_AUTH_MAX_FAILURES=5
# KETSA_AUTH_LOCKOUT_SECONDS=900

# --- Supabase credentials (only when KETSA_DB_BACKEND=supabase) ---------------
# Project URL (Settings -> API) and the SECRET service-role key. The service
# role bypasses Row Level Security, treat it like a password: set it in the
# environment, never in version control. Run backend/db/schema.sql
# once in the Supabase SQL editor before first start.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

# Base URL of the FastAPI backend. Used for server-side data fetching and by
# the dev-time /api rewrite proxy. Must be reachable from the Next.js server.
KETSA_BACKEND_URL=http://127.0.0.1:8000

# Public origin of the FastAPI backend, embedded in the client bundle for the
# live WebSocket market feed (ws://.../api/ws). Only needed when the backend is
# NOT on 127.0.0.1:8000 from the browser's point of view (e.g. Vercel frontend +
# Render backend). Unset => ws://127.0.0.1:8000.
# NEXT_PUBLIC_KETSA_BACKEND_URL=https://ketsa-api.onrender.com

# Optional override for the Content-Security-Policy header emitted by the
# Next.js server. Leave unset to use the built-in policy.
# KETSA_CSP=default-src 'self'; script-src 'self' 'unsafe-inline'; ...
