# =============================================================================
# Ketsa — environment configuration reference
# Copy to `.env` / wire into your deployment and adjust as needed.
# Nothing here is secret; keep real secrets out of version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------

# Comma-separated CORS origin allowlist that may call the API from a browser.
# For local dev keep the defaults; in production set to your hosted frontend
# origin (e.g. https://ketsa.example.com). Never use "*" with credentials.
KETSA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to "1" to expose interactive API docs at /docs, /redoc and the OpenAPI
# schema at /openapi.json. Default is OFF for the public read-only API.
KETSA_EXPOSE_DOCS=0

# Requests allowed per client IP per 60s fixed window. 0 disables the limiter
# (e.g. when a trusted reverse proxy / load balancer handles throttling).
KETSA_RATE_LIMIT_PER_MIN=120

# Stricter per-IP budget for write endpoints (wallet mints, trades, deposits,
# withdrawals). Default 30/min on top of the global limiter.
# KETSA_WRITE_RATE_LIMIT_PER_MIN=30

# Money-movement caps (MWK). Wallets mint at ZERO — there is no free-money
# seed — so these bound how much real money can move per transaction / per
# rolling 24h window per wallet.
# KETSA_MAX_DEPOSIT_MWK=1000000
# KETSA_MAX_WITHDRAWAL_MWK=1000000
# KETSA_DAILY_WITHDRAWAL_LIMIT_MWK=3000000

# Admin login brute-force throttle, per client IP. The admin password is the
# single key to the whole site (user management, password resets, market
# resolution = settling real money), so repeated failures lock the IP out.
# Raise KETSA_ADMIN_MAX_FAILURES if you share the panel across a NAT/office IP.
# KETSA_ADMIN_MAX_FAILURES=10
# KETSA_ADMIN_LOCKOUT_SECONDS=900

# Hard cap on concurrent WebSocket clients, so the live feed cannot be used
# to exhaust backend memory.
# KETSA_WS_MAX_CONNECTIONS=2000

# --- Client-IP trust (set the SAME KETSA_PROXY_SECRET on frontend + backend) ---
# The Next.js runtime proxy (frontend/app/api/[...path]/route.ts) forwards every
# browser /api/* call to this backend. Without help, the backend would see the
# proxy's address for every visitor: one caller could exhaust the shared write
# budget, and anyone could trip the admin lockout and lock the site owner out
# of /admin. When this secret is set on BOTH services, the proxy HMAC-signs the
# real client IP into X-Ketsa-Client-* headers and the backend verifies them.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# KETSA_PROXY_SECRET=

# If you put a known reverse proxy directly in front of the API (Caddy/Nginx),
# you can instead list its IPs/CIDRs here. X-Forwarded-For is honoured only
# when the direct peer is in this list, and the rightmost untrusted hop is used
# (a caller-prepended spoof is discarded). Not needed when the signed proxy
# secret above is configured. Never use 0.0.0.0/0.
# KETSA_TRUSTED_PROXIES=127.0.0.1/32

# Admin panel access. This is THE password for the /admin dashboard.
# Change it! If left unset it defaults to "ketsa-admin" for local dev only.
# In production you MUST set a strong unique value.
KETSA_ADMIN_PASSWORD=change-me-to-a-strong-password

# Storage backend. "memory" (default) keeps data in-process, seeded from the
# static content — great for local dev/previews with zero setup, but data is
# lost on restart. "supabase" persists everything in a Supabase Postgres
# database (production): all admin edits survive restarts/redeploys.
# KETSA_DB_BACKEND=supabase
KETSA_DB_BACKEND=memory

# PayChangu mobile-money gateway for wallet top-ups and payouts (MWK — Airtel
# Money / TNM Mpamba). Payments require the secret key; without it the
# /payments endpoints respond 503. Treat every key as a secret: set it in the
# environment, never in version control, and rotate it if it ever leaks.
# Obtain the keys from the PayChangu dashboard (Settings -> API Keys).
# THIS FILE IS COMMITTED — never put real keys here: set them in backend/.env
# locally (gitignored) or in your host's secret manager.
# PAYCHANGU_SECRET_KEY=your-paychangu-secret-key
# Webhook signing secret (Settings -> API & Webhooks). Without it the
# /api/payments/webhook endpoint responds 503; polling + the reconciler still
# settle payments, so this only costs latency.
# PAYCHANGU_WEBHOOK_SECRET=your-paychangu-webhook-secret
# Base URL (defaults to the production API if unset):
# PAYCHANGU_BASE_URL=https://api.paychangu.com
# Optional operator UUID overrides (defaults are the documented Malawi refs):
# PAYCHANGU_AIRTEL_REF=
# PAYCHANGU_TNM_REF=
# Optional payment tuning (seconds): client poll throttle, stale-initiation
# cutoff (a provider 404 after this fails + refunds), and reconciler interval.
# KETSA_PAYMENT_POLL_SECONDS=3
# KETSA_PAYMENT_STALE_SECONDS=900
# KETSA_PAYMENT_RECONCILE_SECONDS=60

# Account login throttling: failed logins per email before a temporary
# lockout, and how long the lockout lasts. Defaults: 5 failures / 15 minutes.
# KETSA_AUTH_MAX_FAILURES=5
# KETSA_AUTH_LOCKOUT_SECONDS=900

# --- Supabase credentials (only when KETSA_DB_BACKEND=supabase) ---------------
# Project URL (Settings -> API) and the SECRET service-role key. The service
# role bypasses Row Level Security, treat it like a password: set it in the
# environment, never in version control. Run backend/db/schema.sql
# once in the Supabase SQL editor before first start.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend email (signup OTP, password reset, sign-in code, broadcast) --------
# Optional. Powers every email flow:
#   * email registration is held pending until the user enters the 6-digit
#     code emailed by Resend (no account / no seeded wallet until verified)
#   * forgot-password emails a matching reset code for email accounts
#   * passwordless sign-in emails a 6-digit code (POST /api/auth/login/code)
#   * admin -> Broadcast emails one announcement to every account with an email
# Without KETSA_RESEND_API_KEY none of these send real mail: signups still
# return 202 but the code is only written to the server log (dev/offline mode)
# and cannot be used to verify — so production MUST set the key.
#   * KETSA_RESEND_API_KEY - API key from https://resend.com/api-keys
#   * KETSA_RESEND_FROM    - the "from" address; must be on a domain verified
#                            in Resend (defaults to Resend's sandbox, which
#                            only delivers to your own inbox)
# OTP tuning (all optional; defaults shown):
#   * KETSA_OTP_TTL_SECONDS    - code lifetime, default 600
#   * KETSA_OTP_MAX_ATTEMPTS   - wrong entries before the code is burned, default 5
#   * KETSA_OTP_RESEND_SECONDS - cooldown before a new code may be emailed, default 60
#   * KETSA_CODE_REQUEST_MAX / KETSA_CODE_REQUEST_WINDOW - per-IP sign-in-code
#     request throttle (default 5 per 900s), so /api/auth/login/code cannot be
#     turned into an open mail relay.
# KETSA_RESEND_API_KEY=
# KETSA_RESEND_FROM=Ketsa <no-reply@your-verified-domain.com>
# KETSA_OTP_TTL_SECONDS=600
# KETSA_OTP_MAX_ATTEMPTS=5
# KETSA_OTP_RESEND_SECONDS=60
# KETSA_CODE_REQUEST_MAX=5
# KETSA_CODE_REQUEST_WINDOW=900

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

# Base URL of the FastAPI backend. Used for server-side data fetching and by
# the dev-time /api rewrite proxy. Must be reachable from the Next.js server.
KETSA_BACKEND_URL=http://127.0.0.1:8000

# Public origin of the FastAPI backend, embedded in the client bundle for the
# live WebSocket market feed (ws://.../api/ws). Only needed when the backend is
# NOT on 127.0.0.1:8000 from the browser's point of view (e.g. Vercel frontend +
# Render backend). Unset => ws://127.0.0.1:8000.
# NEXT_PUBLIC_KETSA_BACKEND_URL=https://ketsa-api.onrender.com

# --- Supabase public keys (frontend / browser) --------------------------------
# Only needed if the frontend itself talks to Supabase (realtime, auth) — the
# Ketsa backend is what talks to Supabase today. These are PUBLIC keys (safe in
# the client bundle) but Next.js only reads them from frontend/.env.local in dev
# and from the Vercel project env in production — it does not read this
# repo-root file. NEVER put the backend's service-role key here.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional override for the nonce-based Content-Security-Policy emitted by
# frontend/middleware.ts. Use `{nonce}` to keep the per-request script nonce.
# KETSA_CSP=default-src 'self'; script-src 'self' 'nonce-{nonce}' 'strict-dynamic'; ...

# -----------------------------------------------------------------------------
# Crypto deposits (Binance Pay merchant) - USDT rail
# -----------------------------------------------------------------------------
# Used for USDT deposit invoices and (future) crypto payouts. PayChangu remains
# the mobile-money (MWK) provider for Airtel/TNM.
# Configure real Binance Pay merchant credentials and webhook verification, then
# finalize request signing/verification in backend/app/binance_pay.py per the
# current Binance merchant API docs.
# BINANCE_PAY_API_KEY=
# BINANCE_PAY_SECRET_KEY=
# BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
# BINANCE_PAY_WEBHOOK_SECRET=
# BINANCE_PAY_WEBHOOK_PUBLIC_KEY=
# BINANCE_PAY_CRYPTO_CURRENCY=USDT
# BINANCE_PAY_CRYPTO_NETWORK=TRC20
# BINANCE_PAY_MWK_PER_USDT=1750
# BINANCE_PAY_INVOICE_EXPIRE_SECONDS=1800
